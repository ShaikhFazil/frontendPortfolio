# =============================================================================
# Frontend environment variables — TEMPLATE
#
# Copy this to .env.local for local development.
# frontend/.gitignore already excludes .env*.local.
#
# IMPORTANT: every NEXT_PUBLIC_ variable is embedded into the JavaScript the
# browser downloads, at BUILD time. Two consequences:
#
#   1. Never put a secret in a NEXT_PUBLIC_ variable. Anyone can read it by
#      viewing source. There are no secrets in this file, which is correct.
#   2. Changing one of these requires a REBUILD, not a restart. In production
#      they are passed as Docker build arguments (see frontend/Dockerfile and
#      the build step in .github/workflows/deploy.yml).
# =============================================================================

# Base URL of the backend API, no trailing slash.
#
# Local development (backend running via `npm run dev`):
NEXT_PUBLIC_API_URL=http://localhost:5000/api
#
# Production: https://example.com/api
# Note it is a PATH on your own domain, not a separate port. Nginx forwards
# /api to the backend container, which means the browser never talks to port
# 5000 directly, there is no CORS preflight, and no extra certificate.

# Public URL of the site. Used for canonical tags, Open Graph metadata,
# robots.txt and sitemap.xml. Get this wrong and Google indexes the wrong URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seconds a cached page stays fresh before Next regenerates it in the
# background (ISR). 60 means dashboard edits appear on the public site within
# a minute, with no redeploy.
NEXT_PUBLIC_REVALIDATE=60

# -----------------------------------------------------------------------------
# Runtime-only variable (NO NEXT_PUBLIC_ prefix, so it is read when the
# container starts, not when it is built).
#
# Used only by lib/api.ts, which runs on the server during page rendering. It
# lets the frontend container reach the backend directly over the private
# Docker network instead of going out to the internet and back through Nginx.
#
# In production docker-compose sets this to http://backend:5000/api.
# Leave it unset locally: lib/api.ts then falls back to NEXT_PUBLIC_API_URL.
# -----------------------------------------------------------------------------
# API_INTERNAL_URL=http://backend:5000/api
